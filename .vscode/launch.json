{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Extract Core Declarations",
            "program": "${workspaceFolder}/out/extractor.js",
            "preLaunchTask": "npm: compile",
            "args": [
                "--sourceDir=${workspaceFolder}/src/telemetry-sources/vscode",
                "--excludedDir=${workspaceFolder}/src/telemetry-sources/vscode/extensions",
                "--outputDir=${workspaceFolder}",
                "--applyEndpoints",
                "--lowerCaseEvents"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Extract Extensions Declarations",
            "program": "${workspaceFolder}/out/extractor.js",
            "preLaunchTask": "npm: compile",
            "args": [
                "--sourceDir=${workspaceFolder}/src/telemetry-sources/",
                "--outputDir=${workspaceFolder}",
                "--applyEndpoints"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Config Test",
            "program": "${workspaceFolder}/out/extractor.js",
            "preLaunchTask": "npm: compile",
            "args": [
                "--config=${workspaceFolder}/src/tests/mocha/resources/test-config.json"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Mocha All",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "preLaunchTask": "npm: compile",
            "args": [
                "--timeout",
                "999999",
                "--colors",
                "${workspaceFolder}/out/tests/mocha/*.js"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to process",
            "port": 9229
        }
    ]
}
