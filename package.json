{
  "name": "@vscode/telemetry-extractor",
  "version": "2.0.0",
  "description": "Extracts telemetry from VS Code",
  "main": "out/index.js",
  "types": "vscode-telemetry-extractor.d.ts",
  "bin": {
    "vscode-telemetry-extractor": "./out/extractor.js"
  },
  "files": [
    "out",
    "!out/tests",
    "vscode-telemetry-extractor.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode-telemetry-extractor"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint .",
    "test": "mocha --timeout 20000 out/tests/mocha/*.js",
    "coverage": "c8 npm test",
    "extract-core": "node ./out/extractor.js --sourceDir src/telemetry-sources/vscode --excludedDir src/telemetry-sources/vscode/extensions --eventPrefix monacoworkbench/ --outputDir . --applyEndpoints -f telemetry",
    "extract-core-verbose": "node ./out/extractor.js --sourceDir src/telemetry-sources/vscode --excludedDir src/telemetry-sources/vscode/extensions --eventPrefix monacoworkbench/ --outputDir . --applyEndpoints --silenceOutput --verbose"
  },
  "author": "lramos15",
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "command-line-args": "^6.0.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/command-line-args": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "exclude": [
      "out/tests/**",
      "src/tests/**",
      "src/telemetry-sources/**",
      "**/*.d.ts"
    ],
    "reporter": [
      "text-summary",
      "html"
    ]
  }
}
