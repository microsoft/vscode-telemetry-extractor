{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "node20",
    "types": ["node", "mocha"],
    "rootDir": "./src",
    "outDir": "./out",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "src/telemetry-sources",
    "src/tests/mocha/resources",
    "src/tests/mocha/tableResources"
  ]
}
